{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": ".",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["*.config.mjs", "*.config.ts", "tools/quality/**/*.mjs"]
}
