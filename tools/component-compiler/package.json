{
  "name": "@tickdeck/component-compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -b tsconfig.json --force",
    "test:unit": "vitest run --root ../.. --config vitest.config.ts tools/component-compiler/src",
    "codegen:check": "node scripts/check-wit.mjs && node ../quality/no-codegen.mjs tools/component-compiler"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@tickdeck/testkit": "workspace:0.0.0"
  }
}
