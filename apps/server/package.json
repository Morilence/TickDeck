{
  "name": "@tickdeck/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -b tsconfig.json --force",
    "test:unit": "vitest run --root ../.. --config vitest.config.ts apps/server/src",
    "codegen:check": "node ../../tools/quality/no-codegen.mjs apps/server"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@tickdeck/artifact-fs": "workspace:0.0.0",
    "@tickdeck/contracts": "workspace:0.0.0",
    "@tickdeck/core": "workspace:0.0.0",
    "@tickdeck/policies": "workspace:0.0.0",
    "@tickdeck/storage-sqlite": "workspace:0.0.0",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@tickdeck/testkit": "workspace:0.0.0"
  }
}
