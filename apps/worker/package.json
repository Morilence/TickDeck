    "@tickdeck/contracts": "workspace:0.0.0",
    "@tickdeck/core": "workspace:0.0.0",
    "@tickdeck/models": "workspace:0.0.0",
    "@tickdeck/notifications": "workspace:0.0.0",
    "@tickdeck/policies": "workspace:0.0.0"
  },
  "devDependencies": {
    "@tickdeck/testkit": "workspace:0.0.0"
  }
