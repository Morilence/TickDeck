{
  "name": "@tickdeck/policies",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -b tsconfig.json --force",
    "test:unit": "vitest run --root ../.. --config vitest.config.ts packages/policies/src",
    "codegen:check": "node ../../tools/quality/no-codegen.mjs packages/policies"
  }
}
