{
  "name": "@tickdeck/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -b tsconfig.json --force",
    "test:unit": "vitest run --root ../.. --config vitest.config.ts packages/testkit/src",
    "codegen:check": "node ../../tools/quality/no-codegen.mjs packages/testkit"
  },
  "dependencies": {
    "@tickdeck/contracts": "workspace:0.0.0",
    "@tickdeck/core": "workspace:0.0.0",
    "@tickdeck/policies": "workspace:0.0.0"
  }
}
